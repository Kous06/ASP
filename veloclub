cl:{Transmission:["Chaîne (usure)","Cassette","Plateaux","Dérailleur AV","Dérailleur AR","Câbles / gaines"],Freinage:["Plaquettes","Disques / jantes","Étriers","Purge / tension","Leviers"],Roues:["Voile","Rayons","Moyeux","Pneus (usure)","Pression","Valves"],Direction:["Jeu de direction","Potence","Cintre / ruban"],Cadre:["Fissures","Boulonnerie","Selle / tige","Pédalier / BB"]},
admin:{Réservations:[["Réf","Client","Service","Date","Statut"],["B-1001","Client A","Premium Reset","08.10","Confirmée"],["B-1002","Client B","Quick Care","09.10","À planifier"]],Clients:[["Nom","Vélos","Abonnement"],["Client A","2","Club Pro"],["Client B","1","—"]],Techniciens:[["Nom","Zone","Dispo"],["Tech 1","Paris Est","Oui"],["Tech 2","Paris Ouest","Non"]],Entreprises:[["Entreprise","Vélos","Programme"],["Société démo","30","Bike Day"]],Abonnements:[["Formule","Prix","Actifs"],["Club","19 €","—"],["Club Pro","39 €","—"],["Club Black","79 €+","—"]],Zones:[["Zone","Statut"],["Paris intra-muros","Pilote"],["Petite couronne","Sur demande"],["Extension","Future"]]},
P:{"Quick Care":59,"Full Care":129,"Premium Reset":249,"Diagnostic":39,"Nettoyage":49,"Réparation":69}};
// ---------- RENDER ----------
$("#care").innerHTML=D.care.map((c,i)=>`<div class="card rv"><span class="k">0${i+1}</span><h3>${c[0]}</h3><p class="m" style="margin-top:8px">${c[1]}</p></div>`).join("");
$("#offers").innerHTML=D.offers.map(o=>`<div class="card rv ${o[5]?'rec':''}"><span class="k">${o[1]}</span><h3>${o[0]}</h3><div class="price">${o[2]}</div><ul class="ck">${o[3].map(i=>`<li>${i}</li>`).join("")}</ul><button class="b p" onclick="openB('${o[0]}')">${o[4]}</button></div>`).join("");
$("#plans").innerHTML=D.plans.map(p=>`<div class="card rv ${p[3]?'rec':''}"><h3>${p[0]} ${p[3]?'<span class="pill">Recommandé</span>':''}</h3><div class="price">${p[1]}</div><ul class="ck">${p[2].map(i=>`<li>${i}</li>`).join("")}</ul><button class="b ${p[3]?'p':''}" onclick="openB()">Rejoindre le Club</button></div>`).join("");
$("#hs").innerHTML=D.hs.map(h=>`<div class="row"><span>${h[0]}</span><span>${h[1]}</span></div>`).join("");
$("#b2b").innerHTML=D.b2b.map(c=>`<div class="card rv"><h3>${c[0]}</h3><p class="m" style="margin-top:8px">${c[1]}</p></div>`).join("");
// checklist
const all=Object.entries(D.cl).flatMap(([g,a])=>a.map(i=>g+" — "+i));
$("#cl").innerHTML=all.map(t=>`<label class="chk"><input type="checkbox" onchange="sc()"> ${t}</label>`).join("");
function sc(){const n=$$("#cl input:checked").length;$("#ts").textContent=Math.round(n/all.length*100)}sc();
// admin
function tab(k){$$("#tabs .b").forEach(b=>b.classList.toggle("on",b.textContent==k));const r=D.admin[k];$("#tb").innerHTML="<tr>"+r[0].map(h=>`<th>${h}</th>`).join("")+"</tr>"+r.slice(1).map(x=>"<tr>"+x.map(c=>`<td>${c}</td>`).join("")+"</tr>").join("")}
$("#tabs").innerHTML=Object.keys(D.admin).map(k=>`<button class="b" onclick="tab('${k}')">${k}</button>`).join("");tab("Réservations");
// before/after
const cmp=$("#cmp");cmp.querySelector("input").oninput=e=>cmp.style.setProperty("--p",e.target.value+"%");
// bike day
const dates=[...Array(5)].map((_,i)=>{const d=new Date();d.setDate(d.getDate()+14+i*7);return d.toLocaleDateString("fr-FR",{day:"2-digit",month:"short"})});
let bd="";$("#bdslots").innerHTML=dates.map(d=>`<button class="b" onclick="bd='${d}';$$('#bdslots .b').forEach(x=>x.classList.toggle('on',x.textContent=='${d}'))">${d}</button>`).join("");
function bday(){$("#bdok").textContent=bd&&$("#bdmail").value?"Demande enregistrée (démo) — nous revenons vers vous pour le "+bd+".":"Choisissez un créneau et saisissez votre email."}
// ---------- BOOKING ----------
let S={},st=0;
const steps=[{q:"Quel est votre vélo ?",k:"bike",o:["Vélo de ville","Vélo route","VTT","Gravel","Cargo","VAE","Vélo premium"]},{q:"De quoi avez-vous besoin ?",k:"svc",o:Object.keys(D.P)},{q:"Où est votre vélo ?",k:"addr"},{q:"Quand ?",k:"when"},{q:"Votre estimation",k:"sum"}];
function openB(svc){S=svc?{svc}:{};st=0;$("#bk").classList.add("on");rb()}
function cb(){$("#bk").classList.remove("on")}
$("#bk").onclick=e=>{if(e.target.id=="bk")cb()};
function pick(k,v){S[k]=v;st++;rb()}
function rb(){const s=steps[st];let h=`<span class="k">Étape ${st+1}/5</span><h3 style="font-size:26px;margin-bottom:14px">${s.q}</h3>`;
if(s.o)h+=s.o.map(o=>`<button class="b opt ${S[s.k]==o?'sel':''}" onclick="pick('${s.k}','${o}')">${o}</button>`).join("");
else if(s.k=="addr")h+=`<input class="t" id="ad" placeholder="Adresse à Paris" value="${S.addr||""}"><button class="b p" style="margin-top:14px" onclick="S.addr=$('#ad').value;if(S.addr){st++;rb()}">Continuer</button>`;
else if(s.k=="when"){const ds=[...Array(6)].map((_,i)=>{const d=new Date();d.setDate(d.getDate()+i+1);return d.toLocaleDateString("fr-FR",{weekday:"short",day:"2-digit",month:"short"})});
h+=`<div class="tabs">${ds.map(d=>`<button class="b ${S.d==d?'on':''}" onclick="S.d='${d}';rb()">${d}</button>`).join("")}</div><div class="tabs">${["09–11h","11–13h","14–16h","17–19h"].map(t=>`<button class="b ${S.t==t?'on':''}" onclick="S.t='${t}';rb()">${t}</button>`).join("")}</div><button class="b p" onclick="if(S.d&&S.t){st++;rb()}">Continuer</button>`}
else{const pr=D.P[S.svc],pk=S.svc=="Premium Reset"?0:15;h+=`<div class="row"><span>Service</span><span>${S.svc} · ${pr} €</span></div><div class="row"><span>Pickup</span><span>${pk?pk+" €":"Inclus"}</span></div><div class="row"><span>Vélo</span><span>${S.bike}</span></div><div class="row"><span>Créneau</span><span>${S.d} · ${S.t}</span></div><div class="row"><span>Pièces éventuelles</span><span>Sur devis validé</span></div><div class="price">${pr+pk} € <span class="m" style="font-size:14px">estimé</span></div><button class="b p" onclick="conf(${pr+pk})">Confirmer</button><p class="m" style="font-size:12px;margin-top:10px">Paiement en ligne (Stripe) à connecter : cette démo enregistre la demande localement.</p>`}
if(st>0)h+=`<button class="b" style="margin-top:14px;padding:8px 16px" onclick="st--;rb()">← Retour</button>`;
$("#bkb").innerHTML=h}
function conf(t){try{localStorage.setItem("vc_b",JSON.stringify({...S,t}))}catch(e){}$("#bkb").innerHTML=`<h3 style="font-size:26px">Demande reçue ✓</h3><p class="m" style="margin:10px 0 20px">${S.svc} · ${S.d} ${S.t}. Disponibilité confirmée sous 24 h.</p><button class="b p" onclick="cb();location.hash='mybike'">Voir My Bike</button>`;mb()}
function mb(){try{const b=JSON.parse(localStorage.getItem("vc_b"));if(b)$("#myb").innerHTML=`<h3>${b.svc}</h3><p class="m">${b.d} · ${b.t}<br>${b.addr}</p>`}catch(e){}}
// ---------- ROUTER / ANIMS ----------
const V=["home","business","mybike","tech","admin"];
function route(){const h=location.hash.slice(1)||"home";let v=V.includes(h)?h:(h=="bikeday"?"business":"home");$$(".view").forEach(e=>e.classList.toggle("on",e.id=="v-"+v));if(v!=h&&$("#"+h))setTimeout(()=>$("#"+h).scrollIntoView(),30);else scrollTo(0,0);mb();obs()}
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");if(e.target.classList.contains("gauge"))gauge()}}),{threshold:.15});
function obs(){$$(".rv:not(.in)").forEach(e=>io.observe(e))}
let gd=0;function gauge(){if(gd)return;gd=1;$("#arc").style.strokeDashoffset=653.5*(1-.94);let n=0;const t=setInterval(()=>{n+=2;$("#num").textContent=Math.min(n,94);if(n>=94)clearInterval(t)},30)}
addEventListener("hashchange",route);route();
</script></body></html>
